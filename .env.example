# Copy to .env and fill in your own values. Never commit .env.

# Database
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://adaptishield:change-me@127.0.0.1:5432/adaptishield

# Login. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# Browser origins allowed to call the API
CORS_ORIGINS=http://127.0.0.1:5173

# Local models, only needed if Ollama is not on 127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434

# Engine queue and input limits
ENGINE_QUEUE_LIMIT=20
MAX_TOOL_RESPONSE_CHARS=100000
MAX_USER_INPUT_CHARS=10000
